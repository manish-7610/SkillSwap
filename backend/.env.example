# SkillSwap Backend — Environment Variable Template
#
# DO NOT put real credentials here.
# Copy this file to .env and fill in your actual values.
# The .env file is listed in .gitignore and must never be committed.
#
# Generate a secure SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# ── Database (Supabase PostgreSQL — IPv4 Session Pooler) ──────────────────────
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-secure-random-secret-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=SkillSwap API
APP_VERSION=1.0.0
DEBUG=False
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
